MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=idx_ai_agent
MYSQL_DATABASE=idx_exchange

# Recommended on macOS: keep the real password in Keychain.
MYSQL_PASSWORD_KEYCHAIN_SERVICE=IDX_AI_MYSQL

# Optional fallback for non-macOS environments. Never commit a real value.
MYSQL_PASSWORD=

# Week 6/7 embeddings. Prefer Keychain rather than a plaintext API key.
OPENAI_API_KEY_KEYCHAIN_SERVICE=IDX_AI_OPENAI
OPENAI_API_KEY_KEYCHAIN_ACCOUNT=embeddings
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_EMBEDDING_DIMENSIONS=512
OPENAI_RAG_MODEL=gpt-5.6-terra

# Optional fallback for non-macOS environments. Never commit a real value.
OPENAI_API_KEY=

# Add these only when the corresponding weeks need them.
EMAIL_USER=
EMAIL_PASSWORD=
